# ThreatLens - Threat Intelligence & IOC Enrichment Environment Configuration
# Copy this file to .env and populate with valid API keys.
# NEVER commit your actual .env file with live secrets to version control.

# VirusTotal API Key (Free Community or Premium Tier)
# Obtain from: https://www.virustotal.com/
VIRUSTOTAL_API_KEY=

# AbuseIPDB API Key (Free Webmaster or Commercial Tier)
# Obtain from: https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=

# Optional: Incoming Webhook for SOC Alerts (Slack or Discord)
ALERT_WEBHOOK_URL=

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_HOURS=24
CACHE_DB_PATH=.soc_intel_cache.db

# Request Timeouts & Limits (in seconds)
REQUEST_TIMEOUT_SECONDS=10
